# Form bildirimlerinin gideceği e-posta adresi
NOTIFICATION_EMAIL=safa@btgrup.com

# SMTP Sunucu Bilgileri (Hosting / cPanel / Mailbox)
# Not: SMTP_PASS alanına safa@btgrup.com (veya gönderici mail hesabınızın) şifresini yazınız.
SMTP_HOST=mail.btgrup.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=safa@btgrup.com
SMTP_PASS=
SMTP_FROM="Btgrup Web Sitesi" <safa@btgrup.com>
